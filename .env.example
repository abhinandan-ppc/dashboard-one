# AI-Chat Environment Variables
# Copy this file to .env for local development
# For Vercel deployment, add these in Project Settings → Environment Variables

# OmniRoute API Configuration
OMNIROUTE_KEY=sk-61be4b16598dca09-9b9c27-5ae47255
OMNIROUTE_URL_CLOUDFLARE=https://madonna-bowl-greatest-code.trycloudflare.com/v1
OMNIROUTE_URL_NGROK=https://traffic-appetite-relay.ngrok-free.dev/v1
OMNIROUTE_URL_INTRANET=http://localhost:20128/v1

# Session Security (generate a new 32-byte random string for production)
# Production value should be different - use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=03TYSfUgs+F+X6xYlg+8jEcY1Xr1fVXWm3aRnc2b0EI=

# Vercel Blob Storage (get from Vercel Dashboard → Storage → Blob)
# Required for user registry and access control
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx_your_token_here

# Google OAuth (required for authentication)
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Service Account (required for directory API)
GOOGLE_SA_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_IMPERSONATE=admin@jindalsteel.in

# Domain restriction (comma-separated)
ALLOWED_DOMAIN=jindalsteel.in

# Admin emails (comma-separated)
ADMIN_EMAILS=abhinandan.mandal@jindalsteel.in

# Dev hosts for preview access (comma-separated)
DEV_HOSTS=localhost
